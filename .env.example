APP_NAME=FarmRex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farmrex
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BCRYPT_ROUNDS=12

# Dashboard weather (Open-Meteo, no API key needed). Defaults to Butiiti, Kyenjojo.
WEATHER_ENABLED=true
WEATHER_LOCATION="Butiiti, Kyenjojo"
WEATHER_LAT=0.637
WEATHER_LON=30.533
